{
    "name": "tbp:test_flat",
    "font": "tbp:ui_small",
    "text_size": 14,
    "transition_time": 0.06,
    "tooltip_delay": 0.5,
    "palette": {
        "backdrop": "#0000008c",
        "surface": "#26282c",
        "surface_sunken": "#1c1e22",
        "sunken_pressed": "#15161a",
        "raised": "#3a3d44",
        "raised_hover": "#4a4e57",
        "raised_focus": "#414650",
        "raised_disabled": "#2c2e33",
        "pressed": "#2a2c31",
        "selected": "#3d5a8a",
        "outline": "#54585f",
        "outline_strong": "#6a6f78",
        "outline_disabled": "#383a3f",
        "accent": "#9ec1ff",
        "fill": "#6f8fc4",
        "fill_hover": "#86a4d6",
        "fill_disabled": "#44474e",
        "inactive": "#5a5f68",
        "handle": "#c8ccd4",
        "handle_hover": "#e0e3e8",
        "handle_focus": "#d6dbe4",
        "editing": "#7fd69a",
        "editing_outline": "#2f8a4c",
        "label": "#e4e6ea",
        "text": "#e8eaee",
        "text_dim": "#9aa0aa",
        "text_disabled": "#7b7f87",
        "danger": "#7a2a2a",
        "danger_hover": "#923434",
        "danger_pressed": "#5e2020",
        "danger_focus": "#843030",
        "caret_block": "#e8eaee70",
        "thumb": "#4a4e57",
        "fill_soft": "#34486a",
        "fill_soft_hover": "#3c5480",
        "axis_x": "#a8484a",
        "axis_y": "#4f8a3c",
        "axis_z": "#3d6aa8",
        "axis_w": "#6a6f78",
        "axis_text": "#f2f3f5"
    },
    "elements": {
        "panel": {
            "padding": [ 8, 8 ],
            "spacing": 6,
            "background": {
                "kind": "flat",
                "colors": { "normal": "@surface" },
                "outline": { "thickness": 1, "colors": { "normal": "@raised" } }
            },
            "variants": {
                "inset": { "background": { "colors": { "normal": "@surface_sunken" } } },
                "bare": { "padding": [ 0, 0 ], "background": { "kind": "none" } }
            }
        },
        "label": {
            "text": { "normal": "@label" },
            "variants": {
                "heading": { "text": { "normal": "@accent" } },
                "hint": { "text": { "normal": "@text_dim" } }
            }
        },
        "button": {
            "padding": [ 10, 4 ],
            "min_size": [ 24, 24 ],
            "background": {
                "kind": "flat",
                "colors": {
                    "normal": "@raised",
                    "hovered": "@raised_hover",
                    "pressed": "@pressed",
                    "focused": "@raised_focus",
                    "disabled": "@raised_disabled",
                    "selected": "@selected"
                },
                "outline": { "thickness": 1, "colors": { "normal": "@outline", "focused": "@accent", "disabled": "@outline_disabled" } }
            },
            "text": { "normal": "@text", "disabled": "@text_disabled" },
            "variants": {
                "danger": {
                    "background": { "colors": { "normal": "@danger", "hovered": "@danger_hover", "pressed": "@danger_pressed", "focused": "@danger_focus" } }
                }
            }
        },
        "toggle": {
            "box_size": [ 16, 16 ],
            "spacing": 6,
            "min_size": [ 16, 24 ],
            "box": {
                "kind": "flat",
                "colors": { "normal": "@surface_sunken", "hovered": "@pressed", "pressed": "@sunken_pressed", "disabled": "@surface" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline_strong", "focused": "@accent", "disabled": "@raised" } }
            },
            "check": { "kind": "flat", "colors": { "normal": "@accent", "disabled": "@inactive" } },
            "text": { "normal": "@text", "disabled": "@text_disabled" }
        },
        "slider": {
            "min_size": [ 64, 24 ],
            "thumb_size": [ 12, 20 ],
            "track_thickness": 4,
            "track": { "kind": "flat", "colors": { "normal": "@surface_sunken", "disabled": "@surface" } },
            "fill": { "kind": "flat", "colors": { "normal": "@fill", "hovered": "@fill_hover", "disabled": "@fill_disabled" } },
            "thumb": {
                "kind": "flat",
                "colors": { "normal": "@handle", "hovered": "@handle_hover", "pressed": "@accent", "focused": "@handle_focus", "disabled": "@inactive", "entered": "@editing" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline", "focused": "@accent", "entered": "@editing_outline" } }
            }
        },
        "tooltip": {
            "padding": [ 6, 3 ],
            "offset": [ 12, 18 ],
            "max_width": 320,
            "background": {
                "kind": "flat",
                "colors": { "normal": "@raised" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline" } }
            },
            "text": { "normal": "@text" }
        },
        "scrollbar": {
            "thickness": 12,
            "min_thumb_length": 20,
            "thumb_inset": 3,
            "track": { "kind": "flat", "colors": { "normal": "@surface_sunken" } },
            "thumb": { "kind": "flat", "colors": { "normal": "@thumb", "hovered": "@outline_strong", "pressed": "@accent" } }
        },
        "scroll_area": {
            "background": { "kind": "none" }
        },
        "dropdown": {
            "padding": [ 10, 4 ],
            "min_size": [ 48, 24 ],
            "arrow_size": 8,
            "background": {
                "kind": "flat",
                "colors": { "normal": "@raised", "hovered": "@raised_hover", "pressed": "@pressed", "focused": "@raised_focus", "disabled": "@raised_disabled" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline", "focused": "@accent", "disabled": "@outline_disabled" } }
            },
            "text": { "normal": "@text", "disabled": "@text_disabled" },
            "arrow": { "normal": "@text", "disabled": "@inactive" },
            "list": {
                "kind": "flat",
                "colors": { "normal": "@surface" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline_strong" } }
            },
            "list_padding": [ 1, 1 ],
            "row_height": 22,
            "row": { "kind": "flat", "colors": { "normal": "@surface", "hovered": "@raised_hover", "selected": "@selected" } },
            "row_text": { "normal": "@text" },
            "scroll_arrow_height": 12
        },
        "menu": {
            "padding": [ 2, 3 ],
            "item_height": 22,
            "item_padding": [ 8, 0 ],
            "check_width": 18,
            "separator_height": 7,
            "separator_thickness": 1,
            "background": {
                "kind": "flat",
                "colors": { "normal": "@surface" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline_strong" } }
            },
            "item": { "kind": "flat", "colors": { "normal": "@surface", "hovered": "@selected", "focused": "@selected", "selected": "@raised_hover", "disabled": "@surface" } },
            "text": { "normal": "@text", "disabled": "@text_disabled" },
            "shortcut": { "normal": "@text_dim", "disabled": "@text_disabled" },
            "separator": { "kind": "flat", "colors": { "normal": "@outline" } }
        },
        "menu_bar": {
            "padding": [ 2, 0 ],
            "entry_padding": [ 10, 3 ],
            "min_size": [ 0, 24 ],
            "background": { "kind": "flat", "colors": { "normal": "@surface_sunken" } },
            "entry": { "kind": "flat", "colors": { "normal": "@surface_sunken", "hovered": "@raised_hover", "pressed": "@pressed", "focused": "@raised_focus", "selected": "@selected" } },
            "text": { "normal": "@text" }
        },
        "status_bar": {
            "padding": [ 6, 2 ],
            "spacing": 8,
            "min_size": [ 0, 22 ],
            "background": { "kind": "flat", "colors": { "normal": "@surface_sunken" }, "outline": { "thickness": 1, "colors": { "normal": "@raised" } } },
            "text": { "normal": "@text_dim" }
        },
        "backdrop": {
            "background": { "kind": "flat", "colors": { "normal": "@backdrop" } }
        },
        "text_box": {
            "padding": [ 6, 4 ],
            "min_size": [ 120, 24 ],
            "caret_width": 1,
            "mask": "•",
            "box": {
                "kind": "flat",
                "colors": { "normal": "@surface_sunken", "hovered": "@sunken_pressed", "entered": "@sunken_pressed", "disabled": "@surface", "invalid": "@danger_pressed" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline", "hovered": "@outline_strong", "focused": "@accent", "entered": "@editing_outline", "disabled": "@outline_disabled", "invalid": "@danger_hover" } }
            },
            "read_only_box": {
                "kind": "flat",
                "colors": { "normal": "@surface", "disabled": "@surface" },
                "outline": { "thickness": 1, "colors": { "normal": "@raised", "hovered": "@outline", "focused": "@accent", "entered": "@editing_outline", "disabled": "@outline_disabled" } }
            },
            "selection": { "kind": "flat", "colors": { "normal": "@selected" } },
            "inactive_selection": { "kind": "flat", "colors": { "normal": "@inactive" } },
            "caret": { "kind": "flat", "colors": { "normal": "@text" } },
            "overwrite_caret": { "kind": "flat", "colors": { "normal": "@caret_block" } },
            "text": { "normal": "@text", "disabled": "@text_disabled" },
            "placeholder": { "normal": "@text_dim", "disabled": "@text_disabled" }
        },
        "property_box": {
            "padding": [ 6, 3 ],
            "min_size": [ 60, 22 ],
            "caret_width": 1,
            "unit_spacing": 3,
            "box": {
                "kind": "flat",
                "colors": { "normal": "@surface_sunken", "hovered": "@sunken_pressed", "pressed": "@sunken_pressed", "entered": "@sunken_pressed", "disabled": "@surface", "invalid": "@danger_pressed" },
                "outline": { "thickness": 1, "colors": { "normal": "@outline", "hovered": "@outline_strong", "pressed": "@accent", "focused": "@accent", "entered": "@editing_outline", "disabled": "@outline_disabled", "invalid": "@danger_hover" } }
            },
            "fill": { "kind": "flat", "colors": { "normal": "@fill_soft", "hovered": "@fill_soft_hover", "pressed": "@fill_soft_hover", "disabled": "@raised_disabled" } },
            "selection": { "kind": "flat", "colors": { "normal": "@selected" } },
            "caret": { "kind": "flat", "colors": { "normal": "@text" } },
            "text": { "normal": "@text", "disabled": "@text_disabled" },
            "unit": { "normal": "@text_dim", "disabled": "@text_disabled" }
        },
        "labelled": {
            "spacing": 8
        },
        "form": {
            "padding": [ 0, 0 ],
            "spacing": 4
        },
        "compound_slider": {
            "spacing": 6,
            "box_width": 64
        },
        "vector_row": {
            "spacing": 4,
            "tag_width": 16,
            "x_tag": { "kind": "flat", "colors": { "normal": "@axis_x" } },
            "y_tag": { "kind": "flat", "colors": { "normal": "@axis_y" } },
            "z_tag": { "kind": "flat", "colors": { "normal": "@axis_z" } },
            "w_tag": { "kind": "flat", "colors": { "normal": "@axis_w" } },
            "tag_text": { "normal": "@axis_text" }
        }
    }
}
