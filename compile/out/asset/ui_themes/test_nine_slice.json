{
    "name": "tbp:test_nine_slice",
    "font": "tbp:ui_small",
    "text_size": 14,
    "transition_time": 0.06,
    "tooltip_delay": 0.5,
    "palette": {
        "backdrop": "#00000080",
        "surface": "#3b3424",
        "surface_sunken": "#2b261a",
        "surface_disabled": "#4a4436",
        "raised": "#b98f4a",
        "raised_focus": "#c79a50",
        "raised_disabled": "#5c5345",
        "pressed": "#8a6a36",
        "selected": "#7f9c4a",
        "accent": "#d2a65a",
        "accent_hover": "#e6bb6c",
        "accent_bright": "#ffd27a",
        "paper": "#d8c8a0",
        "paper_hover": "#eadcb8",
        "paper_pressed": "#b8a880",
        "paper_disabled": "#6a6250",
        "handle": "#e6d8b4",
        "handle_hover": "#f6ead0",
        "handle_focus": "#f0e2bc",
        "editing": "#9fdc84",
        "ink": "#1e1810",
        "text": "#f2e8d0",
        "text_dim": "#b8ab8c",
        "text_disabled": "#8b8370",
        "danger": "#b0503a",
        "danger_hover": "#c8604a",
        "danger_pressed": "#803828",
        "danger_focus": "#ba5840",
        "caret_block": "#1e181070",
        "paper_read_only": "#c4b894",
        "paper_invalid": "#e6a896",
        "selection_inactive": "#a08f68",
        "paper_fill": "#c2ad78",
        "paper_fill_hover": "#d0bb86",
        "ink_dim": "#5a4e38",
        "axis_x": "#c8705a",
        "axis_y": "#86a85a",
        "axis_z": "#6a8cb0",
        "axis_w": "#a09478",
        "axis_text": "#1e1810",
        "edge_hover": "#d2a65a59",
        "edge_pressed": "#d2a65aa0",
        "zone": "#d2a65a22",
        "zone_hover": "#d2a65a50"
    },
    "elements": {
        "panel": {
            "padding": [ 10, 10 ],
            "spacing": 6,
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@surface" }
            },
            "variants": {
                "inset": { "background": { "colors": { "normal": "@surface_sunken" } } },
                "bare": { "padding": [ 0, 0 ], "background": { "kind": "none" } }
            }
        },
        "label": {
            "text": { "normal": "@text" },
            "variants": {
                "heading": { "text": { "normal": "@accent_bright" } },
                "hint": { "text": { "normal": "@text_dim" } }
            }
        },
        "button": {
            "padding": [ 12, 5 ],
            "min_size": [ 28, 28 ],
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": {
                    "normal": "@raised",
                    "hovered": "@accent",
                    "pressed": "@pressed",
                    "focused": "@raised_focus",
                    "disabled": "@raised_disabled",
                    "selected": "@selected"
                }
            },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "variants": {
                "window_button": {
                    "padding": [ 2, 0 ],
                    "min_size": [ 16, 16 ],
                    "text": { "normal": "@text", "hovered": "@ink", "pressed": "@text", "disabled": "@text_disabled" },
                    "background": { "colors": { "normal": "#00000000", "hovered": "@accent_hover", "pressed": "@pressed", "focused": "#00000000", "disabled": "#00000000" } }
                },
                "window_close": {
                    "padding": [ 2, 0 ],
                    "min_size": [ 16, 16 ],
                    "text": { "normal": "@text", "hovered": "@ink", "pressed": "@text", "disabled": "@text_disabled" },
                    "background": { "colors": { "normal": "#00000000", "hovered": "@danger_hover", "pressed": "@danger_pressed", "focused": "#00000000", "disabled": "#00000000" } }
                },
                "tool": {
                    "padding": [ 5, 5 ],
                    "min_size": [ 28, 28 ]
                },
                "danger": {
                    "background": { "colors": { "normal": "@danger", "hovered": "@danger_hover", "pressed": "@danger_pressed", "focused": "@danger_focus" } }
                }
            }
        },
        "toggle": {
            "box_size": [ 18, 18 ],
            "spacing": 8,
            "min_size": [ 18, 28 ],
            "box": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "pixel_scale": 0.5,
                "colors": { "normal": "@paper", "hovered": "@paper_hover", "pressed": "@paper_pressed", "disabled": "@paper_disabled" }
            },
            "check": {
                "kind": "nine_slice",
                "texture": "tbp:ui_check",
                "margins": 3,
                "colors": { "normal": "@surface", "disabled": "@surface_disabled" }
            },
            "text": { "normal": "@text", "disabled": "@text_disabled" }
        },
        "slider": {
            "min_size": [ 64, 28 ],
            "thumb_size": [ 16, 24 ],
            "track_thickness": 6,
            "track": {
                "kind": "nine_slice",
                "texture": "tbp:ui_track",
                "margins": [ 3, 2, 3, 2 ],
                "colors": { "normal": "@ink", "disabled": "@surface" }
            },
            "fill": {
                "kind": "nine_slice",
                "texture": "tbp:ui_track",
                "margins": [ 3, 2, 3, 2 ],
                "colors": { "normal": "@accent", "hovered": "@accent_hover", "disabled": "@raised_disabled" }
            },
            "thumb": {
                "kind": "nine_slice",
                "texture": "tbp:ui_knob",
                "margins": 5,
                "colors": { "normal": "@handle", "hovered": "@handle_hover", "pressed": "@accent", "focused": "@handle_focus", "disabled": "@paper_disabled", "entered": "@editing" }
            }
        },
        "tooltip": {
            "padding": [ 8, 5 ],
            "offset": [ 12, 18 ],
            "max_width": 320,
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@paper" }
            },
            "text": { "normal": "@ink" }
        },
        "scrollbar": {
            "thickness": 12,
            "min_thumb_length": 20,
            "thumb_inset": 2,
            "track": { "kind": "flat", "colors": { "normal": "@surface_sunken" } },
            "thumb": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@paper", "hovered": "@paper_hover", "pressed": "@accent" } }
        },
        "scroll_area": {
            "background": { "kind": "none" },
            "variants": {
                "window": { "background": { "kind": "none" } }
            }
        },
        "dropdown": {
            "padding": [ 12, 5 ],
            "min_size": [ 48, 28 ],
            "arrow_size": 9,
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@raised", "hovered": "@accent", "pressed": "@pressed", "focused": "@raised_focus", "disabled": "@raised_disabled" }
            },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "arrow": { "normal": "@ink", "disabled": "@text_disabled" },
            "list": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface" } },
            "list_padding": [ 4, 4 ],
            "row_height": 24,
            "row": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@accent", "selected": "@selected" } },
            "row_text": { "normal": "@text", "hovered": "@ink" },
            "scroll_arrow_height": 12
        },
        "menu": {
            "padding": [ 4, 5 ],
            "item_height": 24,
            "item_padding": [ 10, 0 ],
            "check_width": 18,
            "separator_height": 9,
            "separator_thickness": 2,
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface" } },
            "item": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@accent", "focused": "@accent", "selected": "@raised", "disabled": "#00000000" } },
            "text": { "normal": "@text", "hovered": "@ink", "focused": "@ink", "disabled": "@text_disabled" },
            "shortcut": { "normal": "@text_dim", "hovered": "@ink", "focused": "@ink", "disabled": "@text_disabled" },
            "separator": { "kind": "flat", "colors": { "normal": "@surface_sunken" } }
        },
        "menu_bar": {
            "padding": [ 4, 2 ],
            "entry_padding": [ 12, 3 ],
            "min_size": [ 0, 28 ],
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface_sunken" } },
            "entry": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@raised", "pressed": "@pressed", "focused": "@raised_focus", "selected": "@accent" } },
            "text": { "normal": "@text", "hovered": "@ink", "selected": "@ink" }
        },
        "status_bar": {
            "padding": [ 8, 3 ],
            "spacing": 8,
            "min_size": [ 0, 26 ],
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface_sunken" } },
            "text": { "normal": "@text_dim" }
        },
        "backdrop": {
            "background": { "kind": "flat", "colors": { "normal": "@backdrop" } }
        },
        "text_box": {
            "padding": [ 8, 5 ],
            "min_size": [ 120, 28 ],
            "caret_width": 2,
            "mask": "•",
            "box": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@paper", "hovered": "@paper_hover", "entered": "@paper_hover", "disabled": "@paper_disabled", "invalid": "@paper_invalid" }
            },
            "read_only_box": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@paper_read_only", "disabled": "@paper_disabled" }
            },
            "selection": { "kind": "flat", "colors": { "normal": "@accent" } },
            "inactive_selection": { "kind": "flat", "colors": { "normal": "@selection_inactive" } },
            "caret": { "kind": "flat", "colors": { "normal": "@ink" } },
            "overwrite_caret": { "kind": "flat", "colors": { "normal": "@caret_block" } },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "placeholder": { "normal": "@paper_disabled", "disabled": "@text_disabled" }
        },
        "property_box": {
            "padding": [ 8, 4 ],
            "min_size": [ 64, 26 ],
            "caret_width": 2,
            "unit_spacing": 4,
            "box": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@paper", "hovered": "@paper_hover", "pressed": "@paper_pressed", "entered": "@paper_hover", "disabled": "@paper_disabled", "invalid": "@paper_invalid" }
            },
            "fill": { "kind": "nine_slice", "texture": "tbp:ui_track", "margins": [ 3, 2, 3, 2 ], "colors": { "normal": "@paper_fill", "hovered": "@paper_fill_hover", "pressed": "@paper_fill_hover", "disabled": "@raised_disabled" } },
            "selection": { "kind": "flat", "colors": { "normal": "@accent" } },
            "caret": { "kind": "flat", "colors": { "normal": "@ink" } },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "unit": { "normal": "@ink_dim", "disabled": "@text_disabled" }
        },
        "labelled": {
            "spacing": 10
        },
        "form": {
            "padding": [ 0, 0 ],
            "spacing": 6
        },
        "compound_slider": {
            "spacing": 8,
            "box_width": 72
        },
        "vector_row": {
            "spacing": 6,
            "tag_width": 18,
            "x_tag": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@axis_x" } },
            "y_tag": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@axis_y" } },
            "z_tag": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@axis_z" } },
            "w_tag": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@axis_w" } },
            "tag_text": { "normal": "@axis_text" }
        },
        "list": {
            "padding": [ 4, 4 ],
            "row_height": 24,
            "row_padding": 6,
            "cell_size": 16,
            "insertion_thickness": 2,
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@paper", "hovered": "@paper_hover", "focused": "@paper_hover", "entered": "@paper_hover", "disabled": "@paper_disabled" } },
            "row": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@paper_pressed", "selected": "@accent", "disabled": "#00000000" } },
            "current": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 1, "colors": { "normal": "@ink_dim", "entered": "@ink" } } },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "cell": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@paper_hover", "selected": "@paper_fill" } },
            "cell_text": { "normal": "@paper_disabled", "hovered": "@ink_dim", "selected": "@ink" },
            "insertion": { "kind": "flat", "colors": { "normal": "@danger" } }
        },
        "tree": {
            "padding": [ 4, 4 ],
            "row_height": 24,
            "row_padding": 6,
            "indent": 16,
            "cell_size": 16,
            "insertion_thickness": 2,
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@paper", "hovered": "@paper_hover", "focused": "@paper_hover", "entered": "@paper_hover", "disabled": "@paper_disabled" } },
            "row": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@paper_pressed", "selected": "@accent", "disabled": "#00000000" } },
            "current": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 1, "colors": { "normal": "@ink_dim", "entered": "@ink" } } },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "expander": { "normal": "@ink_dim", "hovered": "@ink", "disabled": "@text_disabled" },
            "cell": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@paper_hover", "selected": "@paper_fill" } },
            "cell_text": { "normal": "@paper_disabled", "hovered": "@ink_dim", "selected": "@ink" },
            "insertion": { "kind": "flat", "colors": { "normal": "@danger" } }
        },
        "dialog": {
            "padding": [ 16, 14 ],
            "spacing": 10,
            "button_spacing": 8,
            "button_width": 84,
            "min_size": [ 260, 0 ],
            "max_width": 500,
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface" } }
        },
        "color_picker": {
            "min_size": [ 44, 26 ],
            "checker_size": 6,
            "padding": [ 10, 10 ],
            "spacing": 6,
            "square_size": 160,
            "strip_width": 18,
            "field_width": 56,
            "swatch": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 2, "colors": { "normal": "@raised", "hovered": "@accent", "pressed": "@accent_bright", "focused": "@raised_focus", "disabled": "@raised_disabled" } } },
            "checker_light": { "normal": "@paper" },
            "checker_dark": { "normal": "@paper_pressed" },
            "mixed": { "normal": "@ink", "disabled": "@text_disabled" },
            "popup": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface" } },
            "frame": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 1, "colors": { "normal": "@surface_sunken", "hovered": "@accent", "pressed": "@accent_bright", "focused": "@accent", "entered": "@editing" } } },
            "marker": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 2, "colors": { "normal": "#ffffff" } } },
            "strip_marker": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 2, "colors": { "normal": "#ffffff" } } }
        },
        "toolbar": {
            "padding": [ 4, 4 ],
            "spacing": 3,
            "button_size": [ 28, 28 ],
            "separator_thickness": 2,
            "separator_spacing": 11,
            "background": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface_sunken" } },
            "separator": { "kind": "flat", "colors": { "normal": "@surface" } }
        },
        "drag": {
            "padding": [ 8, 4 ],
            "offset": [ 14, 10 ],
            "max_width": 240,
            "ghost": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@paper", "selected": "@selected", "disabled": "@paper_disabled" } },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "target": { "kind": "flat", "colors": { "normal": "#00000000" }, "outline": { "thickness": 2, "colors": { "normal": "@accent_bright" } } }
        },
        "window": {
            "title_height": 26,
            "title_padding": 7,
            "icon_spacing": 6,
            "button_size": [ 22, 18 ],
            "button_spacing": 3,
            "border": 4,
            "resize_margin": 5,
            "min_size": [ 170, 90 ],
            "minimized_width": 210,
            "content_padding": [ 10, 8 ],
            "content_spacing": 6,
            "frame": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@surface_disabled", "focused": "@surface" } },
            "title_bar": { "kind": "nine_slice", "texture": "tbp:ui_box", "margins": 6, "colors": { "normal": "@raised_disabled", "focused": "@raised" } },
            "title_text": { "normal": "@text_dim", "focused": "@ink" },
            "content_background": { "kind": "flat", "colors": { "normal": "@surface_sunken" } },
            "resize_edge": { "kind": "flat", "colors": { "normal": "#00000000", "hovered": "@edge_hover", "pressed": "@edge_pressed" } },
            "variants": {
                "view": { "content_padding": [ 0, 0 ], "content_spacing": 0 }
            }
        },
        "workspace": {
            "tab_height": 24,
            "tab_padding": 8,
            "tab_spacing": 2,
            "icon_spacing": 5,
            "tab_max_width": 190,
            "splitter_thickness": 5,
            "guide_size": 30,
            "background": { "kind": "flat", "colors": { "normal": "@surface_sunken" } },
            "strip": { "kind": "flat", "colors": { "normal": "@surface_disabled", "focused": "@surface" } },
            "tab": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@raised_disabled", "hovered": "@accent_hover", "pressed": "@pressed", "selected": "@raised" }
            },
            "tab_text": { "normal": "@text_dim", "hovered": "@ink", "selected": "@ink" },
            "splitter": { "kind": "flat", "colors": { "normal": "@surface_sunken", "hovered": "@edge_hover", "pressed": "@edge_pressed" } },
            "zone": {
                "kind": "flat",
                "colors": { "normal": "@zone", "hovered": "@zone_hover" },
                "outline": { "thickness": 1, "colors": { "normal": "@edge_hover", "hovered": "@accent_bright" } }
            },
            "drop_preview": {
                "kind": "flat",
                "colors": { "normal": "@zone_hover" },
                "outline": { "thickness": 2, "colors": { "normal": "@accent_bright" } }
            }
        },
        "render_view": {
            "min_size": [ 64, 48 ],
            "background": { "kind": "flat", "colors": { "normal": "@surface_sunken" } },
            "frame": {
                "kind": "flat",
                "colors": { "normal": "#00000000" },
                "outline": { "thickness": 1, "colors": { "normal": "#00000000", "hovered": "@edge_hover", "focused": "@accent", "entered": "@editing" } }
            }
        }
    }
}
