{
    "name": "tbp:test_nine_slice",
    "font": "tbp:ui_small",
    "text_size": 14,
    "transition_time": 0.06,
    "tooltip_delay": 0.5,
    "palette": {
        "surface": "#3b3424",
        "surface_sunken": "#2b261a",
        "surface_disabled": "#4a4436",
        "raised": "#b98f4a",
        "raised_focus": "#c79a50",
        "raised_disabled": "#5c5345",
        "pressed": "#8a6a36",
        "selected": "#7f9c4a",
        "accent": "#d2a65a",
        "accent_hover": "#e6bb6c",
        "accent_bright": "#ffd27a",
        "paper": "#d8c8a0",
        "paper_hover": "#eadcb8",
        "paper_pressed": "#b8a880",
        "paper_disabled": "#6a6250",
        "handle": "#e6d8b4",
        "handle_hover": "#f6ead0",
        "handle_focus": "#f0e2bc",
        "editing": "#9fdc84",
        "ink": "#1e1810",
        "text": "#f2e8d0",
        "text_dim": "#b8ab8c",
        "text_disabled": "#8b8370",
        "danger": "#b0503a",
        "danger_hover": "#c8604a",
        "danger_pressed": "#803828",
        "danger_focus": "#ba5840"
    },
    "elements": {
        "panel": {
            "padding": [ 10, 10 ],
            "spacing": 6,
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@surface" }
            },
            "variants": {
                "inset": { "background": { "colors": { "normal": "@surface_sunken" } } },
                "bare": { "padding": [ 0, 0 ], "background": { "kind": "none" } }
            }
        },
        "label": {
            "text": { "normal": "@text" },
            "variants": {
                "heading": { "text": { "normal": "@accent_bright" } },
                "hint": { "text": { "normal": "@text_dim" } }
            }
        },
        "button": {
            "padding": [ 12, 5 ],
            "min_size": [ 28, 28 ],
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": {
                    "normal": "@raised",
                    "hovered": "@accent",
                    "pressed": "@pressed",
                    "focused": "@raised_focus",
                    "disabled": "@raised_disabled",
                    "selected": "@selected"
                }
            },
            "text": { "normal": "@ink", "disabled": "@text_disabled" },
            "variants": {
                "danger": {
                    "background": { "colors": { "normal": "@danger", "hovered": "@danger_hover", "pressed": "@danger_pressed", "focused": "@danger_focus" } }
                }
            }
        },
        "toggle": {
            "box_size": [ 18, 18 ],
            "spacing": 8,
            "min_size": [ 18, 28 ],
            "box": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "pixel_scale": 0.5,
                "colors": { "normal": "@paper", "hovered": "@paper_hover", "pressed": "@paper_pressed", "disabled": "@paper_disabled" }
            },
            "check": {
                "kind": "nine_slice",
                "texture": "tbp:ui_check",
                "margins": 3,
                "colors": { "normal": "@surface", "disabled": "@surface_disabled" }
            },
            "text": { "normal": "@text", "disabled": "@text_disabled" }
        },
        "slider": {
            "min_size": [ 64, 28 ],
            "thumb_size": [ 16, 24 ],
            "track_thickness": 6,
            "track": {
                "kind": "nine_slice",
                "texture": "tbp:ui_track",
                "margins": [ 3, 2, 3, 2 ],
                "colors": { "normal": "@ink", "disabled": "@surface" }
            },
            "fill": {
                "kind": "nine_slice",
                "texture": "tbp:ui_track",
                "margins": [ 3, 2, 3, 2 ],
                "colors": { "normal": "@accent", "hovered": "@accent_hover", "disabled": "@raised_disabled" }
            },
            "thumb": {
                "kind": "nine_slice",
                "texture": "tbp:ui_knob",
                "margins": 5,
                "colors": { "normal": "@handle", "hovered": "@handle_hover", "pressed": "@accent", "focused": "@handle_focus", "disabled": "@paper_disabled", "entered": "@editing" }
            }
        },
        "tooltip": {
            "padding": [ 8, 5 ],
            "offset": [ 12, 18 ],
            "max_width": 320,
            "background": {
                "kind": "nine_slice",
                "texture": "tbp:ui_box",
                "margins": 6,
                "colors": { "normal": "@paper" }
            },
            "text": { "normal": "@ink" }
        }
    }
}
